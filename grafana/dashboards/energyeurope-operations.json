          "rawQuery": true,
          "rawSql": "SELECT\r\n  f.country,\r\n  e.wind_electricity                                       AS wind_2025_twh,\r\n  f.forecast_wind_twh                                      AS forecast_2026_twh,\r\n  round((f.forecast_wind_twh - e.wind_electricity)::numeric, 2) AS change_twh\r\nFROM ml.wind_forecast f\r\nJOIN raw.energy e\r\n  ON  e.country = f.country\r\n  AND e.year    = f.forecast_year - 1\r\nORDER BY f.forecast_wind_twh DESC;",
